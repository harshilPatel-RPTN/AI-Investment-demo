# Copy to .env and fill in. There is no backend server: these VITE_ values are built into the website,
# so the key is visible to anyone who opens the site. Restrict the key (HTTP referrer) in Google AI Studio / Cloud console.
VITE_GEMINI_API_KEY=your_key_here
VITE_GEMINI_MODEL=gemini-flash-latest
VITE_GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-flash-lite-latest
# FIN real-time voice (Gemini Live API), connected directly from the browser.
VITE_GEMINI_LIVE_MODELS=gemini-3.8-live,gemini-3.1-flash-live-preview,gemini-2.5-flash-native-audio-latest
VITE_GEMINI_LIVE_VOICE=Puck
