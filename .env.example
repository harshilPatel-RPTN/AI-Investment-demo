# Copy to .env and fill in. Server-side only — never use a VITE_ prefix.
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-flash-lite-latest
PORT=8787
# FIN real-time voice (Gemini Live API). Browser receives only short-lived single-use tokens.
GEMINI_LIVE_MODELS=gemini-3.8-live,gemini-3.1-flash-live-preview,gemini-2.5-flash-native-audio-latest
GEMINI_LIVE_VOICE=Puck
